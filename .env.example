# Copy to .env.local for local dev. Never commit real values.
# Public by design (shipped to the browser); security comes from Postgres RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<replace-me>
# Stable production origin, e.g. https://fitness-tracker.vercel.app (not a per-deploy URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
